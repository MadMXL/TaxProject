{
  "rules": {
    "quotations":     { ".read": "auth != null", ".write": "auth != null" },
    "purchaseOrders": { ".read": "auth != null", ".write": "auth != null" },
    "poCosts":        { ".read": "auth != null", ".write": "auth != null" },
    "materialPrices": { ".read": "auth != null", ".write": "auth != null" },
    "customers":      { ".read": "auth != null", ".write": "auth != null" },
    "products":       { ".read": "auth != null", ".write": "auth != null" },

    "stockItems": {
      ".read": "auth != null",
      ".write": "auth != null && (root.child('users').child(auth.uid).child('role').val() === 'technician' || root.child('users').child(auth.uid).child('role').val() === 'manager' || root.child('users').child(auth.uid).child('role').val() === 'admin')"
    },
    "purchaseRequests": {
      ".read": "auth != null",
      ".write": "auth != null && (root.child('users').child(auth.uid).child('role').val() === 'technician' || root.child('users').child(auth.uid).child('role').val() === 'manager' || root.child('users').child(auth.uid).child('role').val() === 'admin')"
    },
    "stockMoves": {
      ".read": "auth != null",
      ".write": "auth != null && (root.child('users').child(auth.uid).child('role').val() === 'technician' || root.child('users').child(auth.uid).child('role').val() === 'manager' || root.child('users').child(auth.uid).child('role').val() === 'admin')"
    },

    "archive": {
      ".read": "auth != null",
      "$list": {
        ".write": "auth != null && ($list === 'quotations' || $list === 'purchaseOrders' || $list === 'poCosts' || $list === 'materialPrices' || $list === 'customers' || $list === 'products' || $list === 'stockItems')",
        ".indexOn": ["inactiveAt"],
        "$id": {
          ".validate": "newData.hasChildren(['id', 'inactiveAt', 'inactiveReason']) && (newData.child('inactiveReason').val() === 'deleted' || newData.child('inactiveReason').val() === 'archived')"
        }
      }
    },

    "companyInfo": {
      ".read": "auth != null",
      ".write": "auth != null && root.child('users').child(auth.uid).child('role').val() === 'admin'"
    },

    "users": {
      ".read": "auth != null",
      "$uid": {
        ".write": "auth != null && (root.child('users').child(auth.uid).child('role').val() === 'admin' || root.child('users').child(auth.uid).child('role').val() === 'manager')",

        "role": {
          ".validate": "newData.val() === 'admin' || newData.val() === 'manager' || newData.val() === 'sales' || newData.val() === 'technician'"
        }
      }
    },

    "userPhotos": {
      ".read": "auth != null && (root.child('users').child(auth.uid).child('role').val() === 'admin' || root.child('users').child(auth.uid).child('role').val() === 'manager')",
      "$uid": {
        ".read": "auth != null && auth.uid === $uid",
        ".write": "auth != null && (auth.uid === $uid || (root.child('users').child(auth.uid).child('role').val() === 'admin' && !newData.exists()))",
        ".validate": "newData.isString() && newData.val().length < 60000 && newData.val().matches(/^data:image\\/jpeg;base64,[A-Za-z0-9+\\/=]+$/)"
      }
    },

    "stockImages": {
      ".read": "auth != null",
      "$itemId": {
        ".write": "auth != null && (root.child('users').child(auth.uid).child('role').val() === 'manager' || root.child('users').child(auth.uid).child('role').val() === 'admin')",
        ".validate": "newData.isString() && newData.val().length < 60000 && newData.val().matches(/^data:image\\/jpeg;base64,[A-Za-z0-9+\\/=]+$/)"
      }
    },

    "$other": { ".read": false, ".write": false }
  }
}
